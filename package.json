{
  "name": "@okeeffed/gitlab-ci-kit",
  "version": "0.0.7",
  "description": "GitLab CI pipelines in TypeScript",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "generate:types": "tsx scripts/generate-types.ts",
    "lint": "oxlint --max-warnings=0",
    "format": "oxfmt",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "gitlab",
    "gitlab-ci",
    "ci-cd",
    "pipeline",
    "typescript",
    "cdk",
    "yaml"
  ],
  "author": "Dennis O'Keeffe",
  "license": "MIT",
  "dependencies": {
    "@tsconfig/node24": "^24.0.3",
    "yaml": "^2.8.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "json-schema-to-typescript": "^15.0.4",
    "oxfmt": "^0.14.0",
    "oxlint": "^1.29.0",
    "package-up": "^5.0.0",
    "tsdown": "^0.16.5",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3",
    "vitest": "^4.0.10"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
