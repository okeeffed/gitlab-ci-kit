{
  "name": "@okeeffed/gitlab-ci-kit",
  "version": "0.0.1",
  "description": "GitLab CI pipelines in TypeScript",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "generate:types": "tsx scripts/generate-types.ts",
    "lint": "oxlint --max-warnings=0",
    "format": "oxfmt",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "gitlab",
    "gitlab-ci",
    "ci-cd",
    "pipeline",
    "typescript",
    "cdk",
    "yaml"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "change-case": "^5.4.4",
    "package-up": "^5.0.0",
    "snakecase-keys": "^9.0.2",
    "yaml": "^2.3.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.56.0",
    "json-schema-to-typescript": "^15.0.4",
    "oxfmt": "^0.14.0",
    "oxlint": "^1.29.0",
    "prettier": "^3.1.0",
    "tsdown": "^0.16.5",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "type-fest": "^5.2.0",
    "typescript": "^5.3.3",
    "vitest": "^1.0.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
